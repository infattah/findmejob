{
  "profile": {
    "master_cv": "data/profile/master_cv.md",
    "full_name": "",
    "email": "",
    "phone": "",
    "links": {}
  },
  "search": {
    "role_keywords": [
      "growth marketing",
      "performance marketing",
      "digital marketing"
    ],
    "sources": [
      {
        "type": "remotive",
        "search": "growth marketing"
      },
      {
        "type": "greenhouse",
        "board": "exampleco"
      },
      {
        "type": "lever",
        "company": "exampleco"
      },
      {
        "type": "ashby",
        "board": "exampleco"
      },
      {
        "type": "smartrecruiters",
        "company": "exampleco"
      },
      {
        "type": "rss",
        "url": "https://example.com/jobs.xml",
        "name": "example-feed"
      },
      {
        "type": "jsonfile",
        "path": "sample_data/sample_jobs.json"
      }
    ],
    "cache_ttl_seconds": 3600
  },
  "priority": {
    "tiers": [
      "first",
      "high",
      "medium",
      "backup"
    ],
    "title_groups": [
      {
        "name": "Core role",
        "tier": "first",
        "titles": [
          "data analyst",
          "analytics specialist",
          "business intelligence analyst"
        ],
        "stretch_titles": [
          "head of analytics"
        ]
      },
      {
        "name": "Close variant",
        "tier": "first",
        "titles": [
          "product analyst",
          "marketing analyst"
        ]
      },
      {
        "name": "Adjacent role",
        "tier": "high",
        "titles": [
          "data engineer",
          "reporting specialist"
        ]
      },
      {
        "name": "Backup",
        "tier": "backup",
        "titles": [
          "operations analyst"
        ]
      }
    ],
    "seniority": {
      "in_range": [
        "specialist",
        "senior",
        "lead"
      ],
      "stretch": [
        "head of",
        "director"
      ]
    },
    "locations": [
      {
        "name": "Your city",
        "match": [
          "your-city"
        ]
      },
      {
        "name": "Your country",
        "match": [
          "your-country"
        ]
      },
      {
        "name": "Remote in your region",
        "match": [
          "your-region"
        ],
        "remote": true
      }
    ],
    "remote_anywhere_rank": "last",
    "industries": {
      "prefer": [
        "industry-you-prefer"
      ],
      "deprioritise": [
        "industry-you-rank-lower"
      ]
    },
    "wave_order": "title_first",
    "unlisted_titles": "review"
  },
  "policy": {
    "salary_floor": 0,
    "currency": "USD",
    "locations_include": [
      "Remote",
      "Dubai"
    ],
    "locations_exclude": [],
    "sector_exclusions": [
      "sector-you-avoid"
    ],
    "title_exclude": [
      "intern",
      "unpaid"
    ],
    "exchange_rates": {}
  },
  "autonomy": {
    "auto_apply": false,
    "require_confirmation": true,
    "max_applications_per_run": 5,
    "never_pay": true,
    "never_create_accounts": true
  },
  "llm": {
    "provider": "none",
    "model": "",
    "api_key_env": "ANTHROPIC_API_KEY"
  },
  "email": {
    "from_name": "",
    "signature": ""
  },
  "paths": {
    "db": "data/findmejob.db",
    "output": "output",
    "browser_profile": "data/browser-profile",
    "cache": "data/http-cache"
  },
  "email_finder": {
    "_comment": "Verified-address hunt for the email route. Addresses are only read from public pages, never guessed. 'none' disables search-based methods; the hunt then stays 'incomplete' instead of claiming no address exists. search_provider: duckduckgo | searxng (set searxng_url) | none. If the provider blocks automated queries, the hunt reports it as not run; supply pages you opened with --pages.",
    "search_provider": "duckduckgo",
    "searxng_url": "",
    "max_site_pages": 14,
    "max_search_pages": 4,
    "registry_sites": [
      "opencorporates.com"
    ]
  },
  "agency_finder": {
    "_comment": "Recruitment-agency discovery and validation (findmejob agencies). Nothing here is tied to a region: country, city and industry come from the command line. Every method reports found/empty/not_run/error, so a blocked or unconfigured method is never read as 'no agencies'. Search uses the email_finder provider unless search_provider is set here. maps needs a Google Places API key in the environment variable named by maps_api_key_env; without it the method reports not_run. Add directory_sites and job_board_sites that matter where you are looking; agency_keywords and search_terms can be extended for other languages.",
    "methods": [],
    "search_terms": [
      "recruitment agency",
      "recruitment consultancy",
      "staffing agency",
      "employment agency",
      "executive search firm"
    ],
    "agency_keywords": [],
    "directory_sites": [],
    "job_board_sites": [],
    "aggregator_hosts": [],
    "maps_api_key_env": "GOOGLE_MAPS_API_KEY",
    "max_directory_pages": 6,
    "overpass_url": "https://overpass-api.de/api/interpreter"
  }
}
