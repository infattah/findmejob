# Copy to .env and fill in locally. .env is gitignored - never commit real keys.
# All keys are optional. The core pipeline works with no keys at all.

# Optional LLM provider for richer summaries/cover notes: anthropic | openai | ollama | none
FINDMEJOB_LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Optional SMTP for sending application emails you have approved
FINDMEJOB_SMTP_HOST=
FINDMEJOB_SMTP_PORT=587
FINDMEJOB_SMTP_USER=
FINDMEJOB_SMTP_PASSWORD=

# Optional Google Places API key for `findmejob agencies` map discovery and reviews
GOOGLE_MAPS_API_KEY=
